#!/usr/bin/env bash
# ./challenge <id>   — run one challenge's tests (see CHALLENGES.md)
# ./challenge all    — a green/red line per challenge
set -uo pipefail
cd "$(dirname "$0")"
# The kit needs Flutter 3.47 (.fvmrc); use fvm's pin when it is installed.
flutter() { if command -v fvm >/dev/null; then fvm flutter "$@"; else command flutter "$@"; fi; }
run() {
  case "$1" in
  base-01) flutter test test/level_spec_test.dart test/level_reach_test.dart --plain-name 'YOUR LEVEL' ;;
  base-02) flutter test test/challenges/base_02_camera_test.dart ;;
  base-03) flutter test test/challenges/base_03_facing_test.dart ;;
  build-01) flutter test test/challenges/build_01_feet_test.dart ;;
  build-02) flutter test test/challenges/build_02_lean_test.dart ;;
  online-01) flutter test test/run_link_test.dart --plain-name 'RunLink.submit' ;;
  *) echo "unknown challenge: $1 (see CHALLENGES.md)"; return 2 ;;
  esac
}
if [ "${1:-}" = all ]; then
  for id in base-01 base-02 base-03 build-01 build-02 online-01; do
    if run "$id" >/dev/null 2>&1; then echo "GREEN $id"; else echo "red   $id"; fi
  done
else
  run "${1:?usage: ./challenge <id>|all}"
fi
